# App
APP_ENV=development

# Gemini
GEMINI_API_KEY=replace-me
GEMINI_TEXT_MODEL=gemini-2.5-flash

# OpenAI image generation
OPENAI_API_KEY=replace-me
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
IMAGE_SIZE=1024x1280

# Generated files
IMAGE_OUTPUT_DIR=outputs

# Telegram bot
TELEGRAM_BOT_TOKEN=replace-me

# Bluesky automatic publishing
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=replace-me
BLUESKY_SERVICE_URL=https://bsky.social

# Instagram automatic publishing
INSTAGRAM_ACCOUNT_ID=17841430138861031
INSTAGRAM_ACCESS_TOKEN=replace-me
INSTAGRAM_API_VERSION=v22.0
INSTAGRAM_BASE_URL=https://graph.instagram.com

# Supabase Storage for Instagram images
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_BUCKET=instagram-posts

# Optional fallback if not using Supabase
PUBLIC_MEDIA_BASE_URL=https://your-public-domain.example/outputs
